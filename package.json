{
  "name": "shortflow-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch --watch-preserve-output server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch --watch-preserve-output server/index.js",
    "start": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "^0.468.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^174.0.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^9.1.2",
    "eslint": "latest",
    "@eslint/js": "latest",
    "typescript-eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest"
  }
}
